# ==============================================================================
# Central .gitignore: Automated Fabric Warp & Weft Thread Density Analysis
# ==============================================================================

# Python Bytecode, Caches & Environments
__pycache__/
*/__pycache__/
tests/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets, Environment Variables & API Keys
.env
.env.*
*.env
secrets/

# Model Context Protocol (MCP) & Local IDE Agent Configurations
.mcp.json
.agents/mcp_config.json
*mcp_config.json
.antigravity/
.claude/
.cursor/

# Jupyter Notebook Caches
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert/

# IDE & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary Scratch Scripts & Working Directories
scratch/
tmp/
temp/
*.tmp
/test_*.py
temp_*.py
build_and_run_*.py
!tests/
!tests/**

# LaTeX & Typesetting Compilation Artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.html

# LibreOffice & Document Locks
.~lock.*#

# Deep Learning Model Checkpoints & Heavy Weights (> 50 MB)
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.weights
*.h5
!experiments/learned_models/checkpoints/*.pt
experiments/reference_repos/

# Large Archives & Package Installers
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
cloudflared.deb
*.deb
*.rpm
*.AppImage


# Large Datasets (> 10 MB raw captures)
# Only lightweight metadata, synthetic ground truths, and parameters are tracked
data/aitex_database/
data/fabric_defects_benchmark/
data/multiclass_defects/
data/ten_fabrics/
data/textile_weaving_tabular/
data/textile_knitting_tabular/
# data/fabricnet/*.jpg (Tracked: 130 reference images, ~13.3 MB total)
!data/fabricnet/*.jpg
data/fabricnet/*.png
data/fabricnet/*.zip
!data/fabricnet/FabricNet_parameters.xlsx
data/samples/*
!data/samples/.gitkeep
tests/__pycache__/
*.pyc
