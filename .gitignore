# ==============================================================================
# Central .gitignore: Automated Fabric Warp & Weft Thread Density Analysis
# ==============================================================================

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook Caches
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert/

# IDE & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary Scratch Scripts
scratch/
test_*.py
temp_*.py
build_and_run_*.py

# Large Datasets (> 10 MB raw captures)
# Only lightweight metadata, synthetic ground truths, and parameters are tracked
data/aitex_database/
data/fabric_defects_benchmark/
data/multiclass_defects/
data/ten_fabrics/
data/textile_weaving_tabular/
data/textile_knitting_tabular/
data/fabricnet/*.jpg
data/fabricnet/*.png
data/fabricnet/*.zip
!data/fabricnet/FabricNet_parameters.xlsx
data/samples/*
!data/samples/.gitkeep
