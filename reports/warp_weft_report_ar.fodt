     <table:table-cell table:style-name="T2.TDHighlight"><text:p text:style-name="TableCellParaBold">تطابق تام (Δ = 0.0 / 0.5)</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="T2.TD"><text:p text:style-name="TableCellPara">W017</text:p></table:table-cell>
