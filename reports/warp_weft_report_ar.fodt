     <table:table-cell table:style-name="T2.TD"><text:p text:style-name="TableCellPara">32 × 23</text:p></table:table-cell>
     <table:table-cell table:style-name="T2.TD"><text:p text:style-name="TableCellPara">30.0 × 22.0</text:p></table:table-cell>
     <table:table-cell table:style-name="T2.TD"><text:p text:style-name="TableCellPara">36.0 × 32.5</text:p></table:table-cell>
     <table:table-cell table:style-name="T2.TD"><text:p text:style-name="TableCellPara">30.0 سداء / 22.0 لحمة</text:p></table:table-cell>
