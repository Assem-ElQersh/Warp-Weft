{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Assem-ElQersh/Warp-Weft/schemas/client_ground_truth.schema.json",
  "title": "Warp & Weft AI five-region specimen ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fabric_id",
    "regions",
    "expected_regions",
    "specimen_summary",
    "region_matched_count",
    "specimen_only_count"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "fabric_id": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/region"
      },
      "uniqueItems": true
    },
    "expected_regions": {
      "type": "integer",
      "const": 5
    },
    "specimen_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warp_mean_ends_per_cm",
        "weft_mean_picks_per_cm",
        "warp_sample_std_ends_per_cm",
        "weft_sample_std_picks_per_cm"
      ],
      "properties": {
        "warp_mean_ends_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "weft_mean_picks_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "warp_sample_std_ends_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "weft_sample_std_picks_per_cm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "region_matched_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "specimen_only_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "$defs": {
    "nullableText": {
      "type": [
        "string",
        "null"
      ]
    },
    "positiveScale": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabric_id",
        "region_id",
        "image_path",
        "warp_manual_count",
        "weft_manual_count",
        "measurement_length_cm",
        "camera_id",
        "pixels_per_cm_x",
        "pixels_per_cm_y",
        "calibration_source",
        "weave_type",
        "lighting_type",
        "focus_quality",
        "measurement_date",
        "warp_ends_per_cm",
        "weft_picks_per_cm",
        "supervision_level"
      ],
      "properties": {
        "fabric_id": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "warp_manual_count": {
          "type": "integer",
          "minimum": 0
        },
        "weft_manual_count": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_length_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera_id": {
          "$ref": "#/$defs/nullableText"
        },
        "pixels_per_cm_x": {
          "$ref": "#/$defs/positiveScale"
        },
        "pixels_per_cm_y": {
          "$ref": "#/$defs/positiveScale"
        },
        "calibration_source": {
          "$ref": "#/$defs/nullableText"
        },
        "weave_type": {
          "type": "string",
          "minLength": 1
        },
        "lighting_type": {
          "$ref": "#/$defs/nullableText"
        },
        "focus_quality": {
          "$ref": "#/$defs/nullableText"
        },
        "measurement_date": {
          "type": "string",
          "format": "date"
        },
        "warp_ends_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "weft_picks_per_cm": {
          "type": "number",
          "minimum": 0
        },
        "supervision_level": {
          "type": "string",
          "enum": [
            "region_matched",
            "specimen_only"
          ]
        }
      }
    }
  }
}
